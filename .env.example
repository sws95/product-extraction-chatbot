# 로컬 LLM (Ollama). 처음 한 번: docker compose exec ollama ollama pull qwen3:4b-q8_0
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-q8_0
LLM_BASE_URL=http://localhost:11434
LLM_NUM_CTX=4096            # 길수록 VRAM을 더 씀 (4B 기준 요청 하나당 약 0.6GB)
LLM_SEED=42                 # 온도가 0보다 커도 결과가 매번 같게

# 단계별로 다른 모델을 쓰고 싶을 때만 (없으면 LLM_MODEL을 씀)
# EXTRACT_LLM_MODEL=qwen3:4b-q8_0
# ANSWER_LLM_MODEL=qwen3:4b-q8_0

# vLLM으로 바꿀 때
# LLM_PROVIDER=vllm
# LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
# LLM_BASE_URL=http://localhost:8000/v1

# Docker Compose에서는 compose 설정이 아래 값을 덮어쓴다 (qdrant, redis 컨테이너 주소)
# Docker 없이 돌릴 때 비워두면 로컬 파일과 메모리로 동작
QDRANT_URL=
REDIS_URL=

EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_DEVICE=cpu           # 앱 이미지에는 CPU용 torch만 들어 있다
NLI_MODEL=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli   # 원하는 점과 반대되는 리뷰 판정 (CPU, 처음 쓸 때 받음)
STANCE_MODE=nli+prob        # nli: NLI 확정만, nli+prob: 확정 + LLM 확률로 의심되는 상품은 순위만 내림

# 전처리(DuckDB) 메모리 상한
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4
